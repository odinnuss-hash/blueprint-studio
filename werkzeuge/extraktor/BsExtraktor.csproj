<Project Sdk="Microsoft.NET.Sdk">
  <!-- Blueprint Studio – Extraktor. Wird von der App selbst gebaut (Einstellungen → Einrichtungs-Assistent →
       Spielmodelle → „Automatisch holen“). CUE4Parse (Apache-2.0) lädt die App als Quelltext nach quelle\. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BsExtraktor</AssemblyName>
    <RootNamespace>BsExtraktor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8602;CS8604;NU1701;NU1902;NU1903</NoWarn>
    <!-- Stand von CUE4Parse, den auch FModel (Okt. 2026) verwendet -->
    <CueCommit Condition="'$(CueCommit)' == ''">3fc091a085a609bdb7bd2f8934890051b88ac18b</CueCommit>
    <CuePfad Condition="'$(CuePfad)' == ''">$(MSBuildThisFileDirectory)quelle\CUE4Parse-$(CueCommit)\</CuePfad>
    <CUE4PARSE_SKIP_NATIVE>true</CUE4PARSE_SKIP_NATIVE>
    <DefaultItemExcludes>$(DefaultItemExcludes);quelle\**;Export\**;daten\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CuePfad)CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="quelle\**;bin\**;obj\**;Export\**" />
    <None Remove="quelle\**;bin\**;obj\**;Export\**" />
  </ItemGroup>
</Project>
